<Window x:Class="KalkulatorSredniej.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator średniej ważonej ocen"
        Height="600" Width="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        Closing="Window_Closing">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- tytuł -->
            <RowDefinition Height="Auto"/>  <!-- formularz dodawania -->
            <RowDefinition Height="*"/>     <!-- lista przedmiotów -->
            <RowDefinition Height="Auto"/>  <!-- przyciski -->
            <RowDefinition Height="Auto"/>  <!-- wyniki -->
        </Grid.RowDefinitions>

        <!-- Tytuł aplikacji -->
        <TextBlock Grid.Row="0"
                   Text="Kalkulator średniej ważonej ocen"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#1F3B6E"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Formularz dodawania przedmiotu -->
        <GroupBox Grid.Row="1" Header="Dodaj przedmiot" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Nazwa przedmiotu:"/>
                <Label Grid.Row="0" Grid.Column="1" Content="Ocena:"/>
                <Label Grid.Row="0" Grid.Column="2" Content="Waga (ECTS):"/>

                <TextBox x:Name="txtPrzedmiot" Grid.Row="1" Grid.Column="0"
                         Height="26" Margin="5,0" MaxLength="40"
                         VerticalContentAlignment="Center"/>

                <TextBox x:Name="txtOcena" Grid.Row="1" Grid.Column="1"
                         Height="26" Margin="5,0" MaxLength="4"
                         VerticalContentAlignment="Center"/>

                <ComboBox x:Name="cmbWaga" Grid.Row="1" Grid.Column="2"
                          Height="26" Margin="5,0">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                </ComboBox>

                <!-- IsDefault="True" - przycisk działa też po wciśnięciu Enter -->
                <Button x:Name="btnDodaj" Grid.Row="1" Grid.Column="3"
                        Content="Dodaj" Width="80" Height="26" Margin="5,0"
                        IsDefault="True"
                        Click="btnDodaj_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="Dozwolone oceny: 2,0  3,0  3,5  4,0  4,5  5,0"
                           Foreground="Gray" FontSize="11" Margin="5,6,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Lista dodanych przedmiotów -->
        <GroupBox x:Name="grpLista" Grid.Row="2" Header="Lista przedmiotów (0)"
                  Margin="0,10,0,0" Padding="5">
            <ListBox x:Name="lstPrzedmioty" FontSize="13"/>
        </GroupBox>

        <!-- Przyciski operacji na liście -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnUsun" Content="Usuń zaznaczony"
                    Width="130" Height="30" Margin="5"
                    Click="btnUsun_Click"/>
            <Button x:Name="btnWyczysc" Content="Wyczyść wszystko"
                    Width="130" Height="30" Margin="5"
                    Click="btnWyczysc_Click"/>
            <Button x:Name="btnOblicz" Content="Oblicz średnią"
                    Width="130" Height="30" Margin="5"
                    FontWeight="Bold" Background="#CFE0F7"
                    Click="btnOblicz_Click"/>
        </StackPanel>

        <!-- Wyniki obliczeń -->
        <GroupBox Grid.Row="4" Header="Wyniki" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Liczba przedmiotów:"/>
                <TextBlock x:Name="txtLiczba" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Suma punktów ECTS:"/>
                <TextBlock x:Name="txtSumaWag" Grid.Row="0" Grid.Column="3" FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Najwyższa ocena:" Margin="0,4,0,0"/>
                <TextBlock x:Name="txtNajwyzsza" Grid.Row="1" Grid.Column="1" FontWeight="Bold" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Najniższa ocena:" Margin="0,4,0,0"/>
                <TextBlock x:Name="txtNajnizsza" Grid.Row="1" Grid.Column="3" FontWeight="Bold" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Średnia ważona:"
                           FontSize="16" Margin="0,8,0,0"/>
                <TextBlock x:Name="txtSrednia" Grid.Row="2" Grid.Column="1"
                           FontSize="16" FontWeight="Bold" Foreground="#1F3B6E"
                           Margin="0,8,0,0"/>

                <TextBlock x:Name="txtKomunikat" Grid.Row="3" Grid.Column="0"
                           Grid.ColumnSpan="4" Margin="0,8,0,0"
                           FontStyle="Italic" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
